{
  "version": 2,
  "builds": [{ "src": "api/index.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/endpoints.html", "dest": "/public/endpoints.html" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/", "dest": "/public/endpoints.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
